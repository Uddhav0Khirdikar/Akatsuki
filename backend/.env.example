PORT=5000
DATABASE_URL=sqlite://campus_jobs.db
# Required: generate your own value with `openssl rand -hex 32`.
JWT_SECRET=
ERP_BASE_URL=https://erp.mit.asia
ALLOWED_EMAIL_DOMAINS=mit.asia
ENFORCE_COLLEGE_DOMAIN=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Development only. Leave both false for a campus deployment.
ALLOW_LOCAL_AUTH=false
SEED_DEMO_DATA=false
