# Akatsuki Frontend Environment Variables
# API Base URL for Rust Axum backend (default: http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000

# WebSocket Base URL for real-time messaging hub (default: ws://localhost:5000/ws)
VITE_WS_BASE_URL=ws://localhost:5000/ws

# Optional application title
VITE_APP_NAME=Akatsuki Campus Marketplace
